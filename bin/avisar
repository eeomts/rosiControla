#!/usr/bin/env php
<?php


use Controla\Email\ConfiguracaoSmtp;
use Controla\Email\EmailNaoEnviadoException;
use Controla\Email\SmtpRemetente;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require dirname(__DIR__) . '/vendor/autoload.php';

$assunto = trim((string) ($argv[1] ?? ''));

if ($assunto === '') {
    fwrite(STDERR, "uso: echo \"texto\" | php bin/avisar \"assunto\"\n");
    exit(1);
}

$ini = parse_ini_file(dirname(__DIR__) . '/config/config.ini', true) ?: [];
$para = trim((string) ($ini['backup']['avisar'] ?? ''));

if ($para === '') {
    fwrite(STDERR, "sem destino: preencha o [backup] avisar do config.ini\n");
    exit(2);
}

$texto = (string) stream_get_contents(STDIN);
$html = '<pre style="font-family:Consolas,monospace;font-size:14px;line-height:20px">'
    . htmlspecialchars($texto, ENT_QUOTES, 'UTF-8')
    . '</pre>';

$remetente = new SmtpRemetente(static fn (): ConfiguracaoSmtp => ConfiguracaoSmtp::daSecao((array) ($ini['email'] ?? [])));

try {
    $remetente->enviar($para, $assunto, $html, $texto);
} catch (EmailNaoEnviadoException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(3);
}
