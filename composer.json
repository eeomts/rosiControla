{
    "name": "rosi/controla",
    "description": "Controla - controle de estoque e financeiro (Cubo Framework)",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "illuminate/database": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Cubo\\": "cubo/src/",
            "Controla\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Controla\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        }
    }
}
