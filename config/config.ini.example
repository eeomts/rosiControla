;cp config/config.ini.example config/config.ini
;
; Trocar de ambiente e trocar a linha `location` abaixo. Cada ambiente tem o seu
; host.<location> e a sua secao [database.<location>].
;
;   local    php -S localhost:8123 router-dev.php, com o banco na sua maquina
;   docker   os containers rodando na sua maquina para teste
;   wan      a VPS
;
; user e pass ficam ofuscados (Str::cuboDecode desfaz na conexao):
;
;   php bin/encode "a-senha"

[cubo]
location = local

; A barra final faz parte: e dela que sai o caminho base das rotas. Porta
; declarada aqui (so faz sentido em local/docker) vira a porta publicada pelo
; compose.
host.local = http://localhost:8123/
host.docker = http://localhost/
host.wan = https://controla.SEU-DOMINIO.com/

; So quando um nginx do host ja ocupa 80/443 (outros projetos na VPS): o Caddy
; vira HTTP nesta porta local e o nginx repassa. Ver deploy/nginx-controla.conf.
; Vazio, o Caddy fica com 80/443 e emite o certificado sozinho.
; proxy.wan = 127.0.0.1:8081

; qualquer coisa != development manda a excecao para o log em vez da tela
enviroment = development
servidor = LOCAL
versao = V1

table_prefix =
database_prefix =
path_prefix =
redir =
url_login =

[database.local]
; dbtype = mariadb usa o MariaDbConnector nativo do illuminate 11
dbtype = mariadb
host = localhost
port = 3306
db = rosi_controla
user = ""
pass = ""
charset = utf8mb4
collation = utf8mb4_unicode_ci

[database.docker]
dbtype = mariadb
; "db" e o nome do servico no compose.yml;
host = db
port = 3306
db = rosi_controla
user = ""
pass = ""
charset = utf8mb4
collation = utf8mb4_unicode_ci

[database.wan]
dbtype = mariadb
host = db
port = 3306
db = rosi_controla
user = ""
pass = ""
charset = utf8mb4
collation = utf8mb4_unicode_ci

[app]
; Namespace dos controladores resolvidos pela CONVENCAO (/controlador/acao).
; Rota declarada em routing/routes.php traz o FQCN e nao passa por aqui.
controllers = Controla\Controllers\

; View padrao injetada em todo controlador que nao recebe uma.
view = Controla\Views\DefaultView

; Raiz dos templates, relativa a raiz do projeto. Aceita varias, em ordem.
templates = templates/

; Tabela de rotas declaradas;
routes = routing/routes.php

; Onde o `php bin/cubo migrate` procura as migrations.
migrations = database/migrations

timezone = America/Sao_Paulo
charset = UTF-8

;ErrorHandler escreve aqui.
log = storage/logs/erro.log

[email]
; SMTP que manda o codigo de confirmacao do login. No Gmail: senha de APP
; (Conta Google -> Seguranca -> Senhas de app), nunca a senha da conta.
host = smtp.gmail.com
porta = 587
; tls na 587, ssl na 465
seguranca = tls
usuario = seu-email@gmail.com
; codificada: php bin/encode "a-senha-de-app" (sem os espacos que o Google mostra)
senha =
remetente = seu-email@gmail.com
nome_remetente = Controla
