;
;   cp deploy/dev/config.ini.example deploy/dev/config.ini
;
[cubo]
location = local

host.local = http://localhost/
; deixar a barra (/) no final pro nginx resolver corretamente a porta independente dela
host.wan = https://SEU-DOMINIO/

enviroment = development
servidor = DOCKER-DEV
versao = V1

table_prefix =
database_prefix =
path_prefix =
redir =
url_login =

[database.local]
dbtype = mariadb
; "db" e o nome do servico; 3306 e a porta DENTRO da rede do compose (a 3308 do
; host so existe para voce conectar do DataGrip)
host = db
port = 3306
db = rosi_controla
; credenciais sao produzidas a partir do cubo encode
;   docker run --rm -v "$PWD":/app -w /app php:8.2-cli php deploy/cubo-encode.php "valor"
user = ""
pass = ""
charset = utf8mb4
collation = utf8mb4_unicode_ci

[database.wan]
dbtype = mariadb
host = db
port = 3306
db = rosi_controla
user = ""
pass = ""

[app]
; Namespace dos controladores resolvidos pela CONVENCAO (/controlador/acao).
; Rota declarada em routing/routes.php traz o FQCN e nao passa por aqui.
controllers = Controla\Controllers\

; View padrao injetada em todo controlador que nao recebe uma.
view = Controla\Views\DefaultView

; Raiz dos templates, relativa a raiz do projeto. Aceita varias, em ordem.
templates = templates/

; Tabela de rotas declaradas; consultada ANTES da convencao.
routes = routing/routes.php

; Onde o `cubo migrate` procura as migrations.
migrations = database/migrations

timezone = America/Sao_Paulo
charset = UTF-8

; Usado so fora de development: o ErrorHandler escreve aqui.
log = storage/logs/erro.log
